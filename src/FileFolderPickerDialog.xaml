<Window x:Class="xTaskForge.FileFolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Multiple Files &amp; Folders"
        Icon="icon.ico"
        Width="880" Height="620"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#111318" Foreground="#F0F2F6">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header & Shortcuts -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Multi-Item File &amp; Folder Picker" FontSize="18" FontWeight="SemiBold" Foreground="#F0F2F6"/>
        <TextBlock Text="Check any combination of folders and files (even across multiple folders) to add them all at once" Foreground="#9BA4B4" FontSize="12" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock Text="Quick Jump:" Foreground="#737D8D" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
        <Button Content="👤 User Profile" Click="JumpUserProfile_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12"/>
        <Button Content="🖥 Desktop" Click="JumpDesktop_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12"/>
        <Button Content="📁 Documents" Click="JumpDocuments_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12"/>
        <Button Content="💾 C:\" Click="JumpDriveC_Click" Margin="0" Padding="8,4" FontSize="12"/>
      </StackPanel>
    </DockPanel>

    <!-- Navigation / Path Bar -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Content="⬆ Up" Click="GoUp_Click" Width="55" Margin="0,0,6,0" ToolTip="Navigate to parent directory"/>
      <TextBox x:Name="CurrentPathBox" Grid.Column="1" VerticalContentAlignment="Center" Margin="0,0,6,0"
               KeyDown="CurrentPathBox_KeyDown" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" Padding="8,5"/>
      <Button Content="📂 Browse folder..." Grid.Column="2" Click="BrowseFolder_Click" Margin="0,0,6,0" Padding="10,5"/>
      <Button Content="🔄 Refresh" Grid.Column="3" Click="Refresh_Click" Padding="10,5" Margin="0"/>
    </Grid>

    <!-- Items List with Checkboxes -->
    <Border Grid.Row="2" Background="#161920" BorderBrush="#303642" BorderThickness="1" CornerRadius="6">
      <ListView x:Name="FileFolderListView" Background="Transparent" BorderThickness="0" Foreground="#F0F2F6"
                SelectionMode="Extended"
                MouseDoubleClick="FileFolderListView_MouseDoubleClick"
                PreviewKeyDown="FileFolderListView_PreviewKeyDown"
                SizeChanged="FileFolderListView_SizeChanged">
        <ListView.View>
          <GridView x:Name="PickerGridView">
            <GridViewColumn Width="40">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            Checked="ItemCheckBox_Changed" Unchecked="ItemCheckBox_Changed"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Type" Width="75">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <Border Background="{Binding TypeBadgeBg}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding TypeBadgeText}" Foreground="{Binding TypeBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn x:Name="PickerNameCol" Header="Name" Width="380">
              <GridViewColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding IconGlyph}" Margin="0,0,6,0" Foreground="{Binding IconColor}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding NameWeight}" Foreground="#F0F2F6"/>
                  </StackPanel>
                </DataTemplate>
              </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Attributes" DisplayMemberBinding="{Binding AttributesString}" Width="140"/>
            <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding LastModifiedString}" Width="145"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <!-- Quick Selection Tools -->
    <DockPanel Grid.Row="3" Margin="0,10,0,10">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock Text="Select:" Foreground="#9BA4B4" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
        <Button Content="All in view" Click="SelectAll_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12"/>
        <Button Content="All Folders" Click="SelectAllFolders_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12"/>
        <Button Content="All Files" Click="SelectAllFiles_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12"/>
        <Button Content="● Dotfiles (.*)" Click="SelectDotfiles_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12" Background="#1B2B24" BorderBrush="#2E5C45" ToolTip="Select all dot-prefixed files and folders in current view"/>
        <Button Content="Highlighted Rows (Space)" Click="ToggleHighlighted_Click" Margin="0,0,6,0" Padding="8,4" FontSize="12" ToolTip="Check/uncheck all currently highlighted rows"/>
        <Button Content="Clear in view" Click="ClearInView_Click" Padding="8,4" FontSize="12" Margin="0"/>
      </StackPanel>
      <TextBlock x:Name="SelectedCountText" Text="Selected total: 0 item(s)" Foreground="#9FE4B9" FontWeight="SemiBold"
                 DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </DockPanel>

    <!-- Footer Action Buttons -->
    <DockPanel Grid.Row="4" Margin="0,6,0,0">
      <TextBlock Text="💡 Tip: Double-click a folder to open it, or highlight multiple rows with Shift/Ctrl and press Space to check them!"
                 Foreground="#737D8D" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Cancel" Click="Cancel_Click" Width="80" Margin="0,0,8,0"/>
        <Button x:Name="AddHiddenButton" Content="👁 Add as Hidden (0)" Click="AddHidden_Click" Background="#293A59" FontWeight="SemiBold" Margin="0,0,8,0" Padding="12,7" ToolTip="Add selected items as standard Hidden (+H)"/>
        <Button x:Name="AddButton" Content="👻 Add as Super-Hidden (0)" Click="AddSelected_Click" Background="#4A2E70" FontWeight="SemiBold" Margin="0" Padding="14,7" ToolTip="Add selected items as Super-Hidden (+H +S)"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
