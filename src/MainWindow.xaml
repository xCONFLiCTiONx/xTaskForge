<Window x:Class="xTaskForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xTaskForge"
        Icon="icon.ico"
        Width="1020"
        Height="680"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F0F2F6"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
  <Grid Margin="18" Background="#111318">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="xTaskForge" FontSize="26" FontWeight="SemiBold" Foreground="#F0F2F6"/>
        <TextBlock Text="Silent Windows Task Automation · File &amp; Folder Super-Hide · Dynamic Tray API" Foreground="#9BA4B4" Margin="1,2,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="📥 Send to tray" Click="SendToTray_Click" ToolTip="Hide window to system tray" Margin="0,0,10,0"/>
        <Border Background="#1B2B24" BorderBrush="#2E5C45" BorderThickness="1" CornerRadius="8" Padding="12,8">
          <TextBlock x:Name="ApiStatusBadge" Text="● LOCAL IPC ACTIVE" Foreground="#9FE4B9" FontSize="11" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Metrics Cards -->
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#191C23" BorderBrush="#303642" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="AUTOMATION TASKS" Foreground="#9BA4B4" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock x:Name="TaskCountText" Text="0" Foreground="#F0F2F6" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#191C23" BorderBrush="#303642" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="RUNNING PROCESSES" Foreground="#9BA4B4" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock x:Name="RunningCountText" Text="0" Foreground="#9FE4B9" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#191C23" BorderBrush="#303642" BorderThickness="1" CornerRadius="8" Padding="14,12">
        <StackPanel>
          <TextBlock Text="MANAGED FILES &amp; FOLDERS" Foreground="#9BA4B4" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock x:Name="RuleCountText" Text="0" Foreground="#F0F2F6" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Main Tabs -->
    <TabControl Grid.Row="2" Background="#111318" BorderBrush="#303642">
      <!-- Automation Tab -->
      <TabItem Header="Automation Tasks">
        <Grid Margin="12" Background="#111318">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Content="+ Add Task" Click="AddTask_Click" Background="#315AA5" Margin="0,0,8,0"/>
              <Button Content="✏ Edit Task" Click="EditTask_Click" Margin="0,0,8,0"/>
              <Button Content="📝 Edit Script File" Click="EditScriptFile_Click" Margin="0,0,8,0"/>
              <Button Content="▶ Start All" Click="StartAll_Click" Margin="0,0,8,0"/>
              <Button Content="⏹ Stop All" Click="StopAll_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Configured Tasks" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
          </DockPanel>
          <ListView x:Name="TasksList" Grid.Row="1" SelectionMode="Extended"
                    MouseDoubleClick="TasksList_MouseDoubleClick"
                    SizeChanged="TasksList_SizeChanged">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="▶ Start Task" Click="StartTask_Click"/>
                <MenuItem Header="⏹ Stop Task" Click="StopTask_Click"/>
                <Separator/>
                <MenuItem Header="✏ Edit Task Configuration..." Click="EditTask_Click"/>
                <MenuItem Header="📝 Edit Script File in Notepad" Click="EditScriptFile_Click"/>
                <Separator/>
                <MenuItem Header="➕ Add New Task..." Click="AddTask_Click"/>
                <MenuItem Header="🗑 Remove Task" Click="RemoveTask_Click"/>
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView x:Name="TasksGridView">
                <GridViewColumn x:Name="TaskColName" Header="Task" DisplayMemberBinding="{Binding Name}" Width="140"/>
                <GridViewColumn x:Name="TaskColType" Header="Type" DisplayMemberBinding="{Binding ScriptType}" Width="85"/>
                <GridViewColumn x:Name="TaskColScript" Header="Target / Script" DisplayMemberBinding="{Binding ScriptPath}" Width="210"/>
                <GridViewColumn x:Name="TaskColLauncher" Header="Launcher" DisplayMemberBinding="{Binding Launcher}" Width="100"/>
                <GridViewColumn x:Name="TaskColArguments" Header="Arguments" DisplayMemberBinding="{Binding Arguments}" Width="120"/>
                <GridViewColumn x:Name="TaskColAdmin" Header="Admin" DisplayMemberBinding="{Binding DisplayAdmin}" Width="65"/>
                <GridViewColumn x:Name="TaskColStatus" Header="Status" DisplayMemberBinding="{Binding Status}" Width="130"/>
              </GridView>
            </ListView.View>
          </ListView>
          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
              <Button Content="▶ Start Task" Click="StartTask_Click" Background="#286E46" Margin="0,0,8,0" FontWeight="SemiBold"/>
              <Button Content="⏹ Stop Task" Click="StopTask_Click" Background="#823232" Margin="0,0,8,0" FontWeight="SemiBold"/>
              <Button Content="🗑 Remove" Click="RemoveTask_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Tasks run natively in C# or as background scripts. xTaskForge monitors them with zero intrusive notifications."
                       Foreground="#737D8D" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- File & Folder Rules Tab -->
      <TabItem Header="Hide / Super-Hide Files">
        <Grid Margin="12" Background="#111318">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
              <Button Content="📁 Multi-Item Picker..." Click="OpenMultiPicker_Click" Background="#315AA5" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Select multiple files AND folders at the same time (even across folders)"/>
              <Button Content="+ Add Files" Click="AddFiles_Click" Margin="0,0,8,0" ToolTip="Multi-select files via Explorer dialog"/>
              <Button Content="+ Add Folders" Click="AddFolders_Click" Margin="0" ToolTip="Multi-select folders via Explorer dialog"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Hide &amp; Super-Hide Rules" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F6" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Add multiple files &amp; folders simultaneously via Multi-Picker, Explorer multi-select, or Drag-and-Drop · Instant event watcher + auto-check" Foreground="#9BA4B4" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>

          <!-- List with Drop support -->
          <ListView x:Name="RulesList" Grid.Row="1" SelectionMode="Extended"
                    AllowDrop="True" Drop="RulesList_Drop" DragOver="RulesList_DragOver"
                    MouseDoubleClick="RulesList_MouseDoubleClick"
                    SizeChanged="RulesList_SizeChanged">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="👻 Super-Hide Selected (+H +S)" Click="SuperHideSelected_Click"/>
                <MenuItem Header="👁 Hide Selected (+H)" Click="HideSelected_Click"/>
                <MenuItem Header="↩ Restore / Unhide Selected (-H -S)" Click="RestoreSelected_Click"/>
                <Separator/>
                <MenuItem Header="🔁 Toggle Auto-Enforce" Click="ToggleEnforceSelected_Click"/>
                <MenuItem Header="🔄 Enforce All Rules Now" Click="EnforceRules_Click"/>
                <Separator/>
                <MenuItem Header="📁 Add via Multi-Item Picker..." Click="OpenMultiPicker_Click"/>
                <MenuItem Header="📂 Open Containing Folder" Click="OpenRuleFolder_Click"/>
                <Separator/>
                <MenuItem Header="🗑 Remove Rule(s)" Click="RemoveRule_Click"/>
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView x:Name="RulesGridView">
                <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="75"/>
                <GridViewColumn x:Name="RuleColPath" Header="Path" DisplayMemberBinding="{Binding Path}" Width="430"/>
                <GridViewColumn Header="Protection" DisplayMemberBinding="{Binding ProtectionLabel}" Width="115"/>
                <GridViewColumn Header="Current Status" DisplayMemberBinding="{Binding Status}" Width="140"/>
                <GridViewColumn Header="Auto-Enforced" DisplayMemberBinding="{Binding EnforceLabel}" Width="105"/>
              </GridView>
            </ListView.View>
          </ListView>

          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <Button Content="👻 Super-Hide (+H +S)" Click="SuperHideSelected_Click" Background="#4A2E70" FontWeight="SemiBold" Margin="0,0,8,0"
                      ToolTip="Applies Hidden + System (+ ReadOnly for folders). Completely invisible in Explorer unless 'Show protected operating system files' is enabled"/>
              <Button Content="👁 Hide (+H)" Click="HideSelected_Click" Background="#293A59" Margin="0,0,8,0"
                      ToolTip="Applies standard Hidden attribute (+H)"/>
              <Button Content="↩ Restore / Unhide" Click="RestoreSelected_Click" Margin="0,0,8,0"
                      ToolTip="Removes Hidden, System, and ReadOnly attributes and pauses auto-enforcement for selected items"/>
              <Button Content="🔄 Enforce All Now" Click="EnforceRules_Click" Margin="0,0,8,0"
                      ToolTip="Immediately check and enforce all active rules"/>
              <Button Content="🗑 Remove" Click="RemoveRule_Click" Margin="0"/>
            </StackPanel>
            <TextBlock x:Name="RuleWatcherStatusText" Text="💡 Tip: Drag &amp; drop multiple files/folders directly from Explorer!"
                       Foreground="#737D8D" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- Tray Menu & Custom API Tab -->
      <TabItem Header="Tray &amp; Scripting API">
        <Grid Margin="12" Background="#111318">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- API Header & Status -->
          <Border Grid.Row="0" Background="#161920" BorderBrush="#303642" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Local Dynamic Tray &amp; Context Menu IPC" FontSize="15" FontWeight="SemiBold" Foreground="#F0F2F6"/>
                <TextBlock Text="Control tray icons, context menus, and native capabilities via secure Local Named Pipe (\\\\.\\pipe\\xTaskForgePipe) or tray_menu.json" Foreground="#9BA4B4" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="📝 Edit tray_menu.json" Click="OpenTrayMenuJson_Click" Background="#315AA5" FontWeight="SemiBold" Margin="0,0,8,0" ToolTip="Open the tray menu definition JSON in Notepad/code editor (hot-reloads on save!)"/>
                <Button Content="🔄 Reload Tray" Click="ReloadTray_Click" Margin="0,0,8,0"/>
                <Button Content="🎨 Pick Custom Icon..." Click="PickCustomIcon_Click" Margin="0,0,8,0" ToolTip="Open Windows built-in icon picker (defaults to imageres.dll, supports any DLL/EXE/ICO index)"/>
                <Button Content="↺ Reset Default" Click="ResetDefaultIcon_Click" Margin="0" ToolTip="Reset tray icon back to default icon.ico"/>
              </StackPanel>
              <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#252A34" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                    <TextBlock Text="Active Icon: " Foreground="#737D8D" FontSize="12" VerticalAlignment="Center" Cursor="Arrow"/>
                    <TextBlock x:Name="ActiveIconText" Text="Default badge" Foreground="#9FE4B9" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Current active system tray icon" Cursor="Arrow"/>
                    <Button Content="📋 Copy IPC Command" Click="CopyIconString_Click" Padding="6,2" FontSize="11" ToolTip="Copy executable PowerShell Named Pipe command to set active icon to clipboard" Cursor="Hand"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Double-Click Action: " Foreground="#737D8D" FontSize="12" VerticalAlignment="Center" Cursor="Arrow"/>
                    <TextBlock x:Name="DoubleClickActionText" Text="Open Window (Default)" Foreground="#D7B979" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Action executed when double-clicking tray icon" Cursor="Arrow"/>
                    <Button Content="⚙ Change..." Click="ChangeDoubleClickAction_Click" Padding="6,2" FontSize="11" Margin="0,0,4,0" ToolTip="Change the tray icon double-click action" Cursor="Hand"/>
                    <Button Content="↺ Reset Default" Click="ResetDoubleClickAction_Click" Padding="6,2" FontSize="11" ToolTip="Reset tray double-click action to Cycle Audio Device" Cursor="Hand"/>
                  </StackPanel>
                </WrapPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Active Menu Items List -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Menu items view -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                  <Button Content="+ Add" Click="AddTrayMenuItem_Click" Background="#315AA5" Margin="0,0,6,0" Padding="8,3" ToolTip="Add a new tray menu item"/>
                  <Button Content="✏ Edit" Click="EditTrayMenuItem_Click" Margin="0,0,6,0" Padding="8,3" ToolTip="Edit selected tray menu item"/>
                  <Button Content="🗑 Remove" Click="RemoveTrayMenuItem_Click" Margin="0,0,6,0" Padding="8,3" ToolTip="Remove selected tray menu item"/>
                  <Button Content="▲" Click="MoveUpTrayMenuItem_Click" Margin="0,0,4,0" Padding="6,3" ToolTip="Move Up"/>
                  <Button Content="▼" Click="MoveDownTrayMenuItem_Click" Margin="0,0,6,0" Padding="6,3" ToolTip="Move Down"/>
                  <Button Content="─ Separator" Click="AddSeparatorTrayMenuItem_Click" Margin="0" Padding="6,3" ToolTip="Add Menu Separator"/>
                </StackPanel>
                <TextBlock Text="Dynamic Tray Menu Entries" ToolTip="Configured dynamic tray menu entries (shown above defaults)" Foreground="#9BA4B4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
              </DockPanel>
              <ListView x:Name="CustomTrayMenuItemsList" SelectionMode="Single"
                        MouseDoubleClick="CustomTrayMenuItemsList_MouseDoubleClick"
                        SizeChanged="CustomTrayMenuItemsList_SizeChanged">
                <ListView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="✏ Edit Item..." Click="EditTrayMenuItem_Click"/>
                    <MenuItem Header="▶ Test Run / Execute" Click="TestRunTrayMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="▲ Move Up" Click="MoveUpTrayMenuItem_Click"/>
                    <MenuItem Header="▼ Move Down" Click="MoveDownTrayMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="➕ Add New Item..." Click="AddTrayMenuItem_Click"/>
                    <MenuItem Header="─ Add Separator" Click="AddSeparatorTrayMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="🗑 Remove Item" Click="RemoveTrayMenuItem_Click"/>
                  </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                  <GridView x:Name="TrayMenuGridView">
                    <GridViewColumn x:Name="TrayMenuColTitle" Header="Title" DisplayMemberBinding="{Binding DisplayTitle}" Width="180"/>
                    <GridViewColumn x:Name="TrayMenuColCommand" Header="Action / Command" DisplayMemberBinding="{Binding DisplayCommand}" Width="180"/>
                    <GridViewColumn x:Name="TrayMenuColArguments" Header="Arguments" DisplayMemberBinding="{Binding DisplayArguments}" Width="120"/>
                    <GridViewColumn x:Name="TrayMenuColAdmin" Header="Admin" DisplayMemberBinding="{Binding DisplayAdmin}" Width="65"/>
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>

            <!-- Quick Code Guide / Snippets -->
            <Border Grid.Column="1" Background="#161920" BorderBrush="#303642" BorderThickness="1" CornerRadius="6" Padding="12">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Local Pipe IPC Reference" FontSize="14" FontWeight="SemiBold" Foreground="#F0F2F6" Margin="0,0,0,8"/>
                  
                  <TextBlock Text="PowerShell (Named Pipe IPC):" Foreground="#9FE4B9" FontWeight="SemiBold" FontSize="11"/>
                  <TextBox Text="# Cycle audio output device:&#x0a;[System.IO.File]::WriteAllText('\\.\pipe\xTaskForgePipe', 'audio.cycle')&#x0a;# Set tray icon:&#x0a;[System.IO.File]::WriteAllText('\\.\pipe\xTaskForgePipe', 'icon:icon1.ico')&#x0a;# Trigger display actions / profiles:&#x0a;[System.IO.File]::WriteAllText('\\.\pipe\xTaskForgePipe', 'display.toggleHdr')&#x0a;[System.IO.File]::WriteAllText('\\.\pipe\xTaskForgePipe', 'native:res_4k')"
                           IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="10" Background="#111318" Foreground="#E0E6ED" Margin="0,4,0,8" Padding="6"/>

                  <TextBlock Text="CMD / Batch (IPC):" Foreground="#9FE4B9" FontWeight="SemiBold" FontSize="11"/>
                  <TextBox Text=":: Send command via PowerShell IPC:&#x0a;powershell -Command &quot;[System.IO.File]::WriteAllText('\\.\pipe\xTaskForgePipe', 'audio.cycle')&quot;"
                           IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="10" Background="#111318" Foreground="#E0E6ED" Margin="0,4,0,8" Padding="6"/>

                  <Button Content="📁 Open Scripts Folder (E:\.Dev-Vault\Powershell\xTaskForge)" Click="OpenScriptsFolder_Click" Background="#263859" Margin="0,4,0,4"/>
                  <Button Content="⚙ Edit settings.json (script launchers / arguments)" Click="OpenSettingsJson_Click" Background="#263859" Margin="0,0,0,4"/>
                  <Button Content="↻ Reload settings.json after editing" Click="ReloadSettingsJson_Click" Background="#263859" Margin="0,0,0,4"/>
                  <Button Content="📖 Open Full Scripting &amp; API Guide" Click="OpenGuide_Click" Background="#1D2A40" Margin="0,0,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- Footer status -->
          <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Clear All Dynamic Items" Click="ClearCustomMenu_Click" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            <TextBlock Text="Defaults ('Open', 'Hide', 'Exit') remain permanently in the tray. Dynamic items appear cleanly above them."
                       Foreground="#737D8D" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- Activity log Tab -->
      <TabItem Header="Activity Log">
        <Grid Margin="12" Background="#111318">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <Button Content="Clear" DockPanel.Dock="Right" Click="ClearLog_Click" Margin="0"/>
            <TextBlock Text="Execution output and events" FontSize="16" FontWeight="SemiBold" Foreground="#F0F2F6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
          </DockPanel>
          <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12"/>
          <TextBlock Grid.Row="2" Text="Zero notifications. All task events and outputs are logged silently here." Foreground="#D7B979" Margin="0,10,0,0"/>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <CheckBox x:Name="StartWithWindowsCheckbox" Content="Start with Windows"
                  Checked="StartWithWindows_Checked" Unchecked="StartWithWindows_Unchecked"
                  Margin="0,0,16,0" VerticalAlignment="Center"
                  ToolTip="Launch xTaskForge automatically when Windows starts"/>
        <CheckBox x:Name="StartInTrayCheckbox" Content="Start in tray"
                  Checked="StartInTray_Checked" Unchecked="StartInTray_Unchecked"
                  Margin="0,0,16,0" VerticalAlignment="Center"
                  ToolTip="Launch automatically into the system tray"/>
        <CheckBox x:Name="EfficiencyModeCheckbox" Content="Efficiency Mode"
                  Checked="EfficiencyMode_Checked" Unchecked="EfficiencyMode_Unchecked"
                  Margin="0,0,16,0" VerticalAlignment="Center"
                  ToolTip="Enable Windows 11 EcoQoS &amp; BelowNormal priority for minimum CPU/power usage"/>
        <TextBlock x:Name="FooterStatus" Text="Ready" Foreground="#9BA4B4" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="xTaskForge · Local Automation · No Notifications · Secured IPC" Foreground="#737D8D" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
