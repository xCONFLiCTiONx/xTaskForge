<Window x:Class="xTaskForge.TrayItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Menu Item"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#111318"
        Foreground="#F0F2F6">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="DialogTitleText" Text="Edit Tray Menu Item" FontSize="18" FontWeight="SemiBold" Foreground="#F0F2F6"/>
      <TextBlock Text="Configure a dynamic command, script, or preset for your system tray context menu." Foreground="#9BA4B4" FontSize="12" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- Form Fields -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,6,0">
      <CheckBox x:Name="IsSeparatorCheckBox" Content="Menu Separator (draws a clean divider line)" Foreground="#D7B979" FontWeight="SemiBold"
                Checked="IsSeparator_Changed" Unchecked="IsSeparator_Changed" Margin="0,0,0,10"/>

      <CheckBox x:Name="IsSubmenuCheckBox" Content="Submenu (select it, then + Add to put items inside)" Foreground="#61AFEF" FontWeight="SemiBold"
                Checked="IsSeparator_Changed" Unchecked="IsSeparator_Changed" Margin="0,0,0,10"/>

      <!-- Title -->
      <StackPanel x:Name="TitleSection" Margin="0,0,0,10">
        <TextBlock Text="Title / Label (shown in tray menu):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                 Padding="8,6" FontSize="12"/>
      </StackPanel>

      <!-- Action / Command -->
      <StackPanel x:Name="CommandSection" Margin="0,0,0,10">
        <TextBlock Text="Action / Command (script path, executable, or native:...):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="CommandBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse..." Click="BrowseCommand_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
        </Grid>
        <!-- Presets bar -->
        <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock Text="Presets: " Foreground="#737D8D" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button Content="PiP Overlay" Click="PresetPipOverlay_Click" Background="#3B261D" Foreground="#F09B75" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="PiP Pause (10s)" Click="PresetPipPause_Click" Background="#3B261D" Foreground="#F09B75" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Next Audio" Click="PresetNextAudio_Click" Background="#282218" Foreground="#E5C07B" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Open Window" Click="PresetOpen_Click" Background="#1D2A40" Foreground="#61AFEF" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="4K Res" Click="Preset4k_Click" Background="#1B2B24" Foreground="#9FE4B9" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="1440p Res" Click="Preset1440_Click" Background="#1B2B24" Foreground="#9FE4B9" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="1080p Res" Click="Preset1080_Click" Background="#1B2B24" Foreground="#9FE4B9" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Toggle HDR" Click="PresetHdr_Click" Background="#282218" Foreground="#E5C07B" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Keep Awake" Click="PresetKeepAwake_Click" Background="#2B1B2A" Foreground="#C678DD" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Scripts" Click="PresetOpenScripts_Click" Background="#1D2A40" Foreground="#61AFEF" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Explorer" Click="PresetExplorer_Click" Background="#1D2A40" Foreground="#61AFEF" Padding="6,2" FontSize="10" Margin="0,0,4,2"/>
          <Button Content="Notepad" Click="PresetNotepad_Click" Background="#252A34" Foreground="#9BA4B4" Padding="6,2" FontSize="10" Margin="0,0,0,2"/>
        </WrapPanel>
      </StackPanel>

      <!-- Icon Override -->
      <StackPanel x:Name="IconSection" Margin="0,0,0,10">
        <TextBlock Text="Icon Override (optional - e.g. imageres.dll,50, headphones.ico, speakers.ico, or path):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="IconBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse Icon..." Click="BrowseIcon_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4" ToolTip="Open Windows built-in icon picker (defaults to imageres.dll)"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock Text="Icon Presets: " Foreground="#737D8D" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <Button Content="🎧 Headphones" Click="IconHeadphones_Click" Background="#1D2A40" Foreground="#61AFEF" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
          <Button Content="📶 Bluetooth" Click="IconBluetooth_Click" Background="#1D2A40" Foreground="#61AFEF" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
          <Button Content="🔊 Speakers" Click="IconSpeakers_Click" Background="#1D2A40" Foreground="#61AFEF" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
          <Button Content="↺ Auto / Default" Click="IconAuto_Click" Background="#252A34" Foreground="#9BA4B4" Padding="6,2" FontSize="10" Margin="0"/>
        </StackPanel>
      </StackPanel>

      <!-- Dynamic behavior -->
      <StackPanel x:Name="DynamicSection" Margin="0,0,0,10">
        <TextBlock Text="Dynamic behavior (optional) - conditions: process:exe, process:exe args, task:id, state:key, script:path, pip.active (! to negate, &amp;&amp; / ||)" Foreground="#D7B979" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Only show when:" Foreground="#9BA4B4" FontSize="11" VerticalAlignment="Center"/>
          <ComboBox x:Name="VisibleWhenBox" Grid.Column="1" Background="#191C23" Foreground="#000000" BorderBrush="#303642" IsEditable="True" Padding="6,4" FontSize="12">
            <ComboBoxItem Content=""/>
            <ComboBoxItem Content="process:notepad.exe"/>
            <ComboBoxItem Content="!process:notepad.exe"/>
            <ComboBoxItem Content="process:chrome.exe --enable-features"/>
            <ComboBoxItem Content="task:task_id"/>
            <ComboBoxItem Content="state:key_name"/>
            <ComboBoxItem Content="window:Visual Studio"/>
            <ComboBoxItem Content="audio.playing"/>
            <ComboBoxItem Content="pip.active"/>
            <ComboBoxItem Content="!pip.active"/>
            <ComboBoxItem Content="pip.paused"/>
            <ComboBoxItem Content="!pip.paused"/>
            <ComboBoxItem Content="script:scripts/CheckStatus.ps1"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Alternate state when:" Foreground="#9BA4B4" FontSize="11" VerticalAlignment="Center"/>
          <ComboBox x:Name="ToggledWhenBox" Grid.Column="1" Background="#191C23" Foreground="#000000" BorderBrush="#303642" IsEditable="True" Padding="6,4" FontSize="12">
            <ComboBoxItem Content=""/>
            <ComboBoxItem Content="process:notepad.exe"/>
            <ComboBoxItem Content="!process:notepad.exe"/>
            <ComboBoxItem Content="state:key_name"/>
            <ComboBoxItem Content="audio.playing"/>
            <ComboBoxItem Content="pip.paused"/>
            <ComboBoxItem Content="!pip.paused"/>
            <ComboBoxItem Content="pip.active"/>
            <ComboBoxItem Content="!pip.active"/>
          </ComboBox>
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock Text="Alternate title:" Foreground="#9BA4B4" FontSize="11" VerticalAlignment="Center"/>
          <TextBox x:Name="ToggledTitleBox" Grid.Column="1" ToolTip="Title shown when Alternate State condition is met (e.g. 'Stop Process' or 'Close Notepad')" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" Padding="6,4" FontSize="12"/>
        </Grid>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <TextBlock Text="Alternate command:" Foreground="#9BA4B4" FontSize="11" VerticalAlignment="Center"/>
          <TextBox x:Name="ToggledCommandBox" Grid.Column="1" ToolTip="Command executed when clicked in Alternate State (e.g. 'native:kill_process:notepad.exe' or alternate script)" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" Padding="6,4" FontSize="12"/>
          <TextBox x:Name="ToggledArgumentsBox" Grid.Column="2" Margin="6,0,0,0" ToolTip="Alternate arguments for command in Alternate State" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" Padding="6,4" FontSize="12"/>
        </Grid>
      </StackPanel>

      <!-- Arguments -->
      <StackPanel x:Name="ArgumentsSection" Margin="0,0,0,10">
        <TextBlock Text="Arguments (optional parameters or directory for explorer):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ArgumentsBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse Folder..." Click="BrowseFolder_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
          <Button Grid.Column="2" Content="Browse File..." Click="BrowseFile_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
        </Grid>
      </StackPanel>

      <!-- Working Directory -->
      <StackPanel x:Name="WorkingDirSection" Margin="0,0,0,10">
        <TextBlock Text="Working Directory (optional - directory to execute in):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="WorkingDirBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse Folder..." Click="BrowseWorkingDir_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
        </Grid>
      </StackPanel>

      <!-- Execution Options -->
      <StackPanel Margin="0,4,0,10">
        <CheckBox x:Name="RunHiddenCheckBox" Content="Run Hidden (hide console / command prompt window)" Foreground="#9FE4B9" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,8" ToolTip="Executes process silently without opening a visible command prompt or terminal window"/>
        <CheckBox x:Name="RunAsAdminCheckBox" Content="Run as Administrator (elevate process with UAC prompt)" Foreground="#E5C07B" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,8" ToolTip="Launches the script or executable with elevated Administrator privileges (prompts for Windows UAC elevation)"/>
        <CheckBox x:Name="SilentElevateCheckBox" Content="Silent Elevate (run elevated via Task Scheduler — no UAC prompt)" Foreground="#C678DD" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,0" ToolTip="Registers/runs the command in Windows Task Scheduler with Highest Privileges in your user context (one-time UAC setup, then silent forever)"/>
      </StackPanel>
    </StackPanel>
    </ScrollViewer>

    <!-- Footer Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Save Item" Click="Save_Click" Background="#315AA5" FontWeight="SemiBold" IsDefault="True" Margin="0,0,8,0" Padding="16,6"/>
      <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Padding="14,6"/>
    </StackPanel>
  </Grid>
</Window>

