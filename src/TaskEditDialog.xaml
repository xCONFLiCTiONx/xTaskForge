<Window x:Class="xTaskForge.TaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Task"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#111318"
        Foreground="#F0F2F6">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="DialogTitleText" Text="Configure Automation Task" FontSize="18" FontWeight="SemiBold" Foreground="#F0F2F6"/>
      <TextBlock Text="Edit task settings, script target, custom launcher, arguments, and working directory." Foreground="#9BA4B4" FontSize="12" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- Form Fields -->
    <StackPanel Grid.Row="1">
      <!-- Task Name -->
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Task Name:" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                 Padding="8,6" FontSize="12"/>
      </StackPanel>

      <!-- Script / Target Path -->
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Script or Target Executable:" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="ScriptPathBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse..." Click="BrowseScript_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
        </Grid>
      </StackPanel>

      <!-- Custom Launcher -->
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Custom Launcher Executable (leave empty for automatic detection based on extension):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="LauncherBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse..." Click="BrowseLauncher_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
        </Grid>
      </StackPanel>

      <!-- Arguments -->
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Arguments (use {script} placeholder when using a custom launcher):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="ArgumentsBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                 Padding="8,6" FontSize="12"/>
      </StackPanel>

      <!-- Working Directory -->
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="Working Directory (optional, defaults to script folder):" Foreground="#9BA4B4" FontSize="11" Margin="0,0,0,4"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="WorkingDirBox" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="8,6" FontSize="12"/>
          <Button Grid.Column="1" Content="Browse..." Click="BrowseWorkingDir_Click" Background="#263859" Margin="6,0,0,0" Padding="10,4"/>
        </Grid>
      </StackPanel>

      <!-- Execution & Automation Options -->
      <StackPanel Margin="0,2,0,6">
        <CheckBox x:Name="RunHiddenCheckBox" Content="Run Hidden (hide console / command prompt window)" Foreground="#9FE4B9" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,6" ToolTip="Hides the console window when running this script"/>
        <CheckBox x:Name="RunAsAdminCheckBox" Content="Run as Administrator (elevate process with UAC prompt)" Foreground="#E5C07B" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,6" ToolTip="Launches the task process with elevated Administrator privileges"/>
        <CheckBox x:Name="SilentElevateCheckBox" Content="Silent Elevate (run elevated via Task Scheduler — no UAC prompt)" Foreground="#C678DD" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,6" ToolTip="Registers/runs the task in Windows Task Scheduler with Highest Privileges in your user context (one-time UAC setup, then silent forever)"/>
        <CheckBox x:Name="AutoStartCheckBox" Content="Auto-Start when xTaskForge launches" Foreground="#61AFEF" FontWeight="SemiBold"
                  IsChecked="False" Margin="0,0,0,6" ToolTip="Automatically starts this task when xTaskForge opens"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <CheckBox x:Name="LoopCheckBox" Content="Loop / repeat continuously until stopped" Foreground="#D7B979" FontWeight="SemiBold"
                    IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Re-runs the script after it exits until you click Stop Task"/>
          <TextBlock Text="Delay (ms):" Foreground="#9BA4B4" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="LoopDelayBox" Text="1000" Width="70" Background="#191C23" Foreground="#F0F2F6" BorderBrush="#303642" BorderThickness="1"
                   Padding="6,3" FontSize="11" ToolTip="Milliseconds to wait between loop iterations"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- Footer Buttons -->
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <Button Content="📝 Edit Script File in Notepad" Click="OpenScriptFile_Click" Background="#1D2A40" DockPanel.Dock="Left" Padding="10,6"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Save Task" Click="Save_Click" Background="#315AA5" FontWeight="SemiBold" IsDefault="True" Margin="0,0,8,0" Padding="16,6"/>
        <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Padding="14,6"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>

